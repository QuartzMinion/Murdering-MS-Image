      <button class="nav-signin" onclick="openLoginModal()">Sign In</button>
      <button class="btn-primary" onclick="openStepModal()">Start Free Trial →</button>
    </div>

    <button class="hamburger" id="ham" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="nav-drawer" id="drawer">
    <a id="dnav-home" onclick="navigate('home')">Home</a>
    <a id="dnav-steps"    onclick="navigate('steps')">USMLE Guide</a>
    <a id="dnav-pricing"  onclick="navigate('pricing')">Pricing</a>
    <a onclick="openLoginModal()">Sign In</a>
    <button class="btn-primary" onclick="openStepModal()">Start Free Trial →</button>
  </div>
</nav>

<!-- ══════════════════════════════════════════
     PAGE: HOME
══════════════════════════════════════════ -->
<div class="page" id="page-home">

  <!-- HERO -->
  <section class="hero">
    <canvas id="hero-particles"></canvas>
    <div class="hero-glow1"></div><div class="hero-glow2"></div>
    <div class="hero-content">
      <div class="hero-badge"><span class="bdot"></span>Trusted by 30,000+ Medical Students</div>
      <h1>Master Your <span>USMLE</span></h1>
      <p class="hero-sub">Score Higher, Study Smarter</p>
      <p class="hero-desc">Join <strong>30,000+ students</strong> who improved their scores with our <strong>AI-powered platform</strong>. Get instant AI-powered feedback, personalized insights, and unlimited practice.</p>
      <div class="hero-pills">
        <div class="hero-pill">🤖 AI-POWERED</div>
        <div class="hero-pill">∞ UNLIMITED</div>
        <div class="hero-pill">📊 ANALYTICS</div>
      </div>
      <div class="hero-btns">
        <button class="btn-primary" style="font-size:15px;padding:14px 28px;" onclick="openStepModal()">START FREE TRIAL →</button>
        <button class="btn-ghost" onclick="navigate('steps')">▶ Explore USMLE Guide</button>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hvw">
        <img class="hero-main-img" src="https://www.medicospira.com/HOME_ph1.png" alt="MedicoSpira Platform UI">
        <div class="fbadge" style="bottom:-20px;right:20px;">
          <div class="ficon" style="background:#EBF2FC;">👥</div>
          <div><div class="flbl">ACTIVE USERS</div><div class="fval">2,847 <span style="color:#16A34A;font-size:11px;">↑12%</span></div></div>
        </div>
        <div class="fbadge" style="bottom:-20px;left:-16px;">
          <div class="ficon" style="background:#DCFCE7;">✅</div>
          <div><div class="flbl">SUCCESS RATE</div><div class="fval" style="font-size:13px;">98% Pass Rate</div></div>
        </div>
        <div class="live-pill" style="top:-14px;right:20px;">LIVE</div>
      </div>
    </div>
  </section>

  <!-- ECG HEARTBEAT BAR -->
  <div class="ecg-bar" id="ecg-bar">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path class="ecg-line" id="ecg-path"
        d="M0,40 L120,40 L150,40 L165,10 L180,70 L195,20 L210,55 L225,40
           L360,40 L390,40 L405,10 L420,70 L435,20 L450,55 L465,40
           L600,40 L630,40 L645,10 L660,70 L675,20 L690,55 L705,40
           L840,40 L870,40 L885,10 L900,70 L915,20 L930,55 L945,40
           L1080,40 L1110,40 L1125,10 L1140,70 L1155,20 L1170,55 L1185,40
           L1440,40"
      />
    </svg>
  </div>

  <!-- WHY -->
  <section class="why">
    <div class="why-head reveal">
      <div class="stag">WHY CHOOSE US</div>
      <h2 class="stitle">Why Choose <span>Medicospira</span></h2>
      <p class="sdesc" style="max-width:520px;margin:0 auto;">Elevate your USMLE prep with tools designed to optimize your study experience and maximize your score.</p>
    </div>
    <div class="why-stats reveal" style="transition-delay:.15s;">
      <div class="why-stat"><div class="why-stat-num" data-target="30000" data-suffix="+">30,000+</div><div class="why-stat-lbl">Students Enrolled</div></div>
      <div class="why-stat"><div class="why-stat-num" data-target="98" data-suffix="%">98%</div><div class="why-stat-lbl">Pass Rate</div></div>
      <div class="why-stat"><div class="why-stat-num" data-target="10000" data-suffix="+">10,000+</div><div class="why-stat-lbl">Practice Questions</div></div>
      <div class="why-stat"><div class="why-stat-num" data-target="4.9" data-suffix="★">4.9★</div><div class="why-stat-lbl">Average Rating</div></div>
    </div>
    <div class="why-grid stagger-children">
      <div class="wcard"><div class="wcard-stripe stripe-1"></div><div class="wcard-body"><div class="wicon ic1"><svg viewBox="0 0 24 24" fill="none" stroke="#1E5FBE" stroke-width="1.8" stroke-linecap="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg></div><p class="wcard-title">User-Friendly</p><p class="wcard-desc">Access interactive dashboards with a platform built for your learning convenience.</p><span class="wcard-link" onclick="navigate('steps')">Learn more →</span></div></div>
      <div class="wcard"><div class="wcard-stripe stripe-2"></div><div class="wcard-body"><div class="wicon ic2"><svg viewBox="0 0 24 24" fill="none" stroke="#0891B2" stroke-width="1.8" stroke-linecap="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></div><p class="wcard-title">Streamlined</p><p class="wcard-desc">A clean, intuitive design that lets you focus on learning — not navigating menus.</p><span class="wcard-link" onclick="navigate('steps')">Learn more →</span></div></div>
      <div class="wcard"><div class="wcard-stripe stripe-3"></div><div class="wcard-body"><div class="wicon ic3"><svg viewBox="0 0 24 24" fill="none" stroke="#7C3AED" stroke-width="1.8" stroke-linecap="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div><p class="wcard-title">Fast Loading</p><p class="wcard-desc">Lightning-fast loading times for study sessions that keep pace with your goals.</p><span class="wcard-link" onclick="navigate('steps')">Learn more →</span></div></div>
      <div class="wcard"><div class="wcard-stripe stripe-4"></div><div class="wcard-body"><div class="wicon ic4"><svg viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="1.8" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><p class="wcard-title">Comprehensive</p><p class="wcard-desc">Unlimited access to all resources, questions, and tools across every USMLE step.</p><span class="wcard-link" onclick="navigate('steps')">Learn more →</span></div></div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="sec sec-center reveal" style="background:white;">
    <div class="stag">HOW IT WORKS</div>
    <h2 class="stitle">Your Path to <span>USMLE Success</span></h2>
    <p class="sdesc">Four simple steps from signup to exam-day confidence.</p>
    <div class="how-row" style="margin-top:52px;">
      <div class="how-step"><div class="how-num">1</div><h4>Create Account</h4><p>Select your USMLE step and sign up in seconds to get instant access to your QBank.</p></div>
      <div class="how-step"><div class="how-num">2</div><h4>Customize Your Test</h4><p>Choose your subjects, systems, and topics, then set the number of questions to match your study goals.</p></div>
      <div class="how-step"><div class="how-num">3</div><h4>Practice & Improve</h4><p>Create your test and start solving questions. Review detailed explanations with Ai, focus on incorrect answers, and strengthen weak areas.</p></div>
      <div class="how-step"><div class="how-num">4</div><h4>Master & Succeed</h4><p>Reset and retake questions for a second round. Track your progress, boost your score, and walk into the USMLE with confidence.</p></div>
    </div>
  </section>

  <!-- STEPS -->
  <section class="steps">
    <div class="steps-glow"></div>
