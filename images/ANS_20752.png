</body></html>
<script>
/* All navigate() calls use onclick attributes — we expose the function
   on window so it is available from the very first click, regardless
   of when the browser parses this script tag.             */

/* ── ROUTER ─────────────────────────────────────────────── */
const pages   = ['home','steps','pricing','privacy','terms'];
const navIds  = {home:'nav-home',features:'nav-features',steps:'nav-steps',pricing:'nav-pricing'};
const dnavIds = {home:'dnav-home',features:'dnav-features',steps:'dnav-steps',pricing:'dnav-pricing'};

window.navigate = function(target){
  const ham    = document.getElementById('ham');
  const drawer = document.getElementById('drawer');
  if(ham)    ham.classList.remove('open');
  if(drawer) drawer.classList.remove('open');

  pages.forEach(p=>{
    const el = document.getElementById('page-'+p);
    if(!el) return;
    el.classList.remove('active');
    el.style.display = 'none';
  });

  const targetEl = document.getElementById('page-'+target);
  if(!targetEl){ console.warn('Page not found: page-'+target); return; }
  targetEl.style.display = 'block';
  void targetEl.offsetWidth;          // force reflow → triggers CSS transition
  targetEl.classList.add('active');

  Object.keys(navIds).forEach(k=>{
    const a = document.getElementById(navIds[k]);
    if(a) a.classList.toggle('active', k === target);
  });
  Object.keys(dnavIds).forEach(k=>{
    const a = document.getElementById(dnavIds[k]);
    if(a) a.classList.toggle('active', k === target);
  });

  window.scrollTo({top:0, behavior:'smooth'});

  const titles = {
    home      : 'Medicospira – Master Your USMLE',
    features  : 'Features – Medicospira',
    steps     : 'USMLE Guide – Medicospira',
    pricing   : 'Pricing – Medicospira',
    privacy   : 'Privacy Policy – Medicospira',
    terms     : 'Terms of Service – Medicospira',
  };
  document.title = titles[target] || 'Medicospira';

  if(target === 'home') setTimeout(initHomeAnimations, 80);
};

/* ── HAMBURGER ───────────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', function(){
  const ham    = document.getElementById('ham');
  const drawer = document.getElementById('drawer');
  if(ham) ham.addEventListener('click', function(){
    this.classList.toggle('open');
    drawer.classList.toggle('open');
  });
});

/* ── PRICING PLAN DROPDOWN ───────────────────────────────── */
window.onPlanChange = function(select){
  const opt = select.options[select.selectedIndex];
  if(!opt) return;
  const target = select.dataset.target;
  const priceEl  = document.getElementById(target + '-price');
  const periodEl = document.getElementById(target + '-period');
  if(priceEl  && opt.dataset.price)  priceEl.textContent  = opt.dataset.price;
  if(periodEl && opt.dataset.period) periodEl.textContent = opt.dataset.period;
};

/* ── FAQ ACCORDION ───────────────────────────────────────── */
window.toggleFaq = function(el){
  const answer = el.nextElementSibling;
  const icon   = el.querySelector('.faq-q-icon');
  const isOpen = answer.classList.contains('open');
  document.querySelectorAll('.faq-a').forEach(a => a.classList.remove('open'));
  document.querySelectorAll('.faq-q-icon').forEach(i => i.classList.remove('open'));
  if(!isOpen){ answer.classList.add('open'); icon.classList.add('open'); }
};

/* ── STEP-CONTEXT PRICING ────────────────────────────────── */
let pricingFromStep = null;
const stepNames = {
  step1  : { label:'Step 1',    color:'#1E5FBE', bg:'#E8F1FC', emoji:'📖' },
  step2ck: { label:'Step 2 CK', color:'#0891B2', bg:'#CFFAFE', emoji:'🏥' },
  step3  : { label:'Step 3',    color:'#D97706', bg:'#FEF3C7', emoji:'⏰' },
};

window.navigatePricing = function(fromStep){
  pricingFromStep = fromStep;
  navigate('pricing');
  setTimeout(function(){
    switchPricingStep(fromStep);
    renderPricingContext();
  }, 60);
};

window.switchPricingStep = function(step){
  // Hide all panels
  ['step1','step2ck','step3'].forEach(function(s){
    const panel = document.getElementById('pricing-'+s);
    const tab   = document.getElementById('ptab-'+s);
    if(panel) panel.style.display = 'none';
    if(tab)   tab.classList.remove('ptab-active');
  });
  // Show selected panel
  const activePanel = document.getElementById('pricing-'+step);
  const activeTab   = document.getElementById('ptab-'+step);
  if(activePanel) activePanel.style.display = 'grid';
  if(activeTab)   activeTab.classList.add('ptab-active');
  // Update notice label
  const labels = { step1:'Step 1', step2ck:'Step 2 CK', step3:'Step 3' };
  const lbl = document.getElementById('ptab-step-label');
  if(lbl) lbl.textContent = labels[step] || 'Step 1';
};

function renderPricingContext(){
  const existing = document.getElementById('step-context-banner');
  if(existing) existing.remove();
  if(!pricingFromStep) return;
  const step = stepNames[pricingFromStep];
  const hero = document.querySelector('#page-pricing .page-hero');
  if(!hero || !step) return;
  const banner = document.createElement('div');
  banner.id = 'step-context-banner';
  banner.style.cssText = [
    'max-width:860px;margin:24px auto 0;',
    'background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.20);',
    'border-radius:14px;padding:16px 24px;',
    'display:flex;align-items:center;gap:14px;flex-wrap:wrap;',
    'position:relative;z-index:1;'
  ].join('');
  banner.innerHTML =
    '<div style="width:40px;height:40px;border-radius:10px;background:'+step.bg+';display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">'+step.emoji+'</div>'+
    '<div style="flex:1;min-width:160px;">'+
      '<p style="font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:2px;">Coming from</p>'+
      '<p style="font-size:15px;font-weight:700;color:white;">'+step.label+' Preparation</p>'+
    '</div>'+
    '<p style="font-size:13px;color:rgba(255,255,255,.70);flex:2;min-width:180px;line-height:1.55;">'+
      '&#x2705; Your plan includes <strong style="color:white;">'+step.label+' and all steps</strong> — one subscription covers everything.'+
    '</p>'+
    '<button onclick="navigate(\''+pricingFromStep+'\')" style="background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);border-radius:8px;color:white;font-size:13px;font-weight:600;padding:8px 16px;cursor:pointer;white-space:nowrap;flex-shrink:0;">'+
      '&larr; Back to '+step.label+
    '</button>';
  hero.appendChild(banner);
}

/* ── SCORE CALCULATOR ────────────────────────────────────── */
let currentStep = 'step1';
const stepPassingBase = { step1:194, step2ck:209, step3:198 };
const stepMaxScore    = { step1:270, step2ck:270, step3:270 };
const stepAvg         = { step1:232, step2ck:245, step3:228 };

window.selectStep = function(btn, step){
  currentStep = step;
  document.querySelectorAll('.step-btn').forEach(b=>{
    b.style.border = '2px solid var(--border)';
    b.style.background = 'white';
    b.style.color = 'var(--text-muted)';
  });
  btn.style.border = '2px solid var(--cobalt)';
  btn.style.background = 'var(--sky-bg)';
  btn.style.color = 'var(--cobalt)';
  updateCalc();
};

window.updateCalc = function(){
  const pctEl  = document.getElementById('pct-correct');
  if(!pctEl) return;
  const pct   = parseInt(pctEl.value);
  const qDone = parseInt(document.getElementById('q-done').value);
  const weeks = parseInt(document.getElementById('weeks').value);
  const nbme  = parseInt(document.getElementById('nbme-score').value);

  document.getElementById('pct-val').textContent  = pct + '%';
  document.getElementById('q-val').textContent    = qDone >= 1000 ? (qDone/1000).toFixed(1).replace('.0','')+'K' : qDone.toLocaleString();
  document.getElementById('wk-val').textContent   = weeks + (weeks===1?' week':' weeks');
  document.getElementById('nbme-val').textContent = nbme === 0 ? 'None' : nbme;

  const base = stepPassingBase[currentStep];
  const maxS = stepMaxScore[currentStep];
  const range = maxS - base;
  const qFactor = Math.min(Math.max((pct-30)/65,0),1);
  const vFactor = Math.min(Math.max((qDone-100)/4900,0),1);
  const tFactor = Math.min(Math.max((weeks-2)/22,0),1);
  let composite = qFactor*0.55 + vFactor*0.25 + tFactor*0.20;
  let estimated = nbme > 0
    ? (base + composite*range)*0.35 + nbme*0.65
    : base + composite*range;
  estimated = Math.round(Math.min(Math.max(estimated, base-10), maxS));
  const low  = Math.max(estimated-6, base-8);
  const high = Math.min(estimated+6, maxS);

  document.getElementById('score-display').textContent = estimated;
  document.getElementById('score-range').textContent   = 'Range: '+low+' – '+high;

  const badge = document.getElementById('score-badge');
  const avg   = stepAvg[currentStep];
  const styles = {
    red   : 'display:inline-flex;align-items:center;gap:8px;background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.30);border-radius:100px;padding:7px 18px;font-size:13px;font-weight:700;color:#F87171;',
    amber : 'display:inline-flex;align-items:center;gap:8px;background:rgba(245,158,11,.15);border:1px solid rgba(245,158,11,.30);border-radius:100px;padding:7px 18px;font-size:13px;font-weight:700;color:#FCD34D;',
    green : 'display:inline-flex;align-items:center;gap:8px;background:rgba(34,197,94,.15);border:1px solid rgba(34,197,94,.30);border-radius:100px;padding:7px 18px;font-size:13px;font-weight:700;color:#4ADE80;',
    blue  : 'display:inline-flex;align-items:center;gap:8px;background:rgba(96,165,250,.15);border:1px solid rgba(96,165,250,.30);border-radius:100px;padding:7px 18px;font-size:13px;font-weight:700;color:#60A5FA;',
  };
  if(estimated < base)       { badge.style.cssText = styles.red;   badge.textContent = '⚠️ Below Passing — Need More Prep'; }
  else if(estimated < avg-10){ badge.style.cssText = styles.amber; badge.textContent = '📈 Passing — Room to Improve'; }
  else if(estimated < avg+10){ badge.style.cssText = styles.green; badge.textContent = '✅ Above Average'; }
  else                       { badge.style.cssText = styles.blue;  badge.textContent = '🏆 Excellent — Competitive Score'; }

  const qPct = Math.round(qFactor*100);
  const vPct = Math.round(vFactor*100);
  const tPct = Math.round(tFactor*100);
  document.getElementById('bd-q').textContent     = qPct + '%';
  document.getElementById('bd-v').textContent     = vPct + '%';
  document.getElementById('bd-t').textContent     = tPct + '%';
  document.getElementById('bd-q-bar').style.width = qPct + '%';
  document.getElementById('bd-v-bar').style.width = vPct + '%';
  document.getElementById('bd-t-bar').style.width = tPct + '%';

  const advice = document.getElementById('advice-text');
  if(estimated < base)       advice.textContent = 'Your estimate is below the passing threshold of '+base+'. Focus on raising your qbank % correct to at least 55% and add more study weeks.';
  else if(pct < 55)          advice.textContent = 'Your % correct is the main limiter. Slow down, review every wrong answer thoroughly, and target 55%+ before sitting the exam.';
  else if(qDone < 1500)      advice.textContent = 'Fewer than 1,500 questions done. Ramp up to 40–60 questions per day. Exposure volume significantly boosts exam performance.';
  else if(estimated >= avg+15) advice.textContent = 'Excellent trajectory! Take 1–2 more full-length mock exams to confirm readiness, then eliminate any remaining weak spots.';
  else advice.textContent = 'Solid path. Increase daily questions to 50+, keep flashcard reviews consistent, and consider an NBME practice exam to calibrate your real score.';
};

/* ── RESPONSIVE STYLES FOR NEW PAGES ────────────────────── */
(function(){
  const s = document.createElement('style');
  s.textContent = [
    '@media(max-width:1024px){',
    '.steps-hub-grid{grid-template-columns:1fr!important;}',
    '.step-detail-grid{grid-template-columns:1fr!important;}',
    '.calc-layout{grid-template-columns:1fr!important;}',
    '.guide-grid{grid-template-columns:1fr!important;}',
    '.career-grid{grid-template-columns:1fr!important;}',
    '.tips-grid{grid-template-columns:1fr 1fr!important;}',
    '.bench-grid{grid-template-columns:1fr!important;}',
    '}',
    '@media(max-width:480px){',
    '.tips-grid{grid-template-columns:1fr!important;}',
    '.bench-grid{grid-template-columns:1fr!important;}',
    '}'
  ].join('');
  document.head.appendChild(s);
})();

/* ── SCROLL PROGRESS BAR ─────────────────────────────────── */
function initScrollProgress(){
  const bar = document.getElementById('scroll-progress');
  if(!bar) return;
  window.addEventListener('scroll', function(){
    const scrolled = window.scrollY;
    const total    = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.transform = 'scaleX(' + (total > 0 ? scrolled/total : 0) + ')';
  }, { passive:true });
}

/* ── PARTICLE CANVAS ─────────────────────────────────────── */
function initParticles(){
  const canvas = document.getElementById('hero-particles');
  if(!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, particles = [];
  function resize(){
    const hero = canvas.parentElement;
    W = canvas.width  = hero ? hero.offsetWidth  : window.innerWidth;
    H = canvas.height = hero ? hero.offsetHeight : 600;
  }
  resize();
  window.addEventListener('resize', resize);
  function Particle(){this.reset();}
  Particle.prototype.reset = function(){
    this.x = Math.random()*W; this.y = H + Math.random()*40;
    this.r = Math.random()*2 + .5; this.speed = Math.random()*.5 + .3;
    this.drift = (Math.random()-.5)*.4; this.opacity = 0;
    this.maxOpacity = Math.random()*.5 + .1;
    this.life = 0; this.maxLife = Math.random()*200 + 150;
  };
  Particle.prototype.update = function(){
    this.y -= this.speed; this.x += this.drift; this.life++;
    if(this.life < 30) this.opacity = (this.life/30)*this.maxOpacity;
    else if(this.life > this.maxLife-30) this.opacity = ((this.maxLife-this.life)/30)*this.maxOpacity;
    else this.opacity = this.maxOpacity;
    if(this.life >= this.maxLife) this.reset();
  };
  Particle.prototype.draw = function(){
    ctx.beginPath(); ctx.arc(this.x,this.y,this.r,0,Math.PI*2);
    ctx.fillStyle = 'rgba(96,165,250,'+this.opacity+')'; ctx.fill();
  };
  for(let i=0;i<60;i++){
    const p = new Particle();
    p.y = Math.random()*H; p.life = Math.random()*p.maxLife;
    particles.push(p);
  }
  (function loop(){ ctx.clearRect(0,0,W,H); particles.forEach(function(p){p.update();p.draw();}); requestAnimationFrame(loop); })();
}

/* ── SCROLL REVEAL ───────────────────────────────────────── */
function initScrollReveal(){
  const sel = '#page-home .reveal, #page-home .reveal-left, #page-home .reveal-right, #page-home .reveal-scale, #page-home .stagger-children';
  const obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        e.target.classList.add('revealed');
        if(e.target.classList.contains('reveal-left')) triggerScoreBars();
        obs.unobserve(e.target);
      }
    });
  },{threshold:0.12});
  document.querySelectorAll(sel).forEach(function(el){ obs.observe(el); });
}

/* ── ECG ANIMATION ───────────────────────────────────────── */
function initECG(){
  const ecgEl = document.getElementById('ecg-bar');
  if(!ecgEl) return;
  const line = ecgEl.querySelector('.ecg-line');
  if(!line) return;
  const obs = new IntersectionObserver(function(entries){
    if(entries[0].isIntersecting){ line.classList.add('animated'); obs.disconnect(); }
  },{threshold:.3});
  obs.observe(ecgEl);
}

/* ── STAT COUNTERS ───────────────────────────────────────── */
function initCounters(){
  const obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ animateCounter(e.target); obs.unobserve(e.target); }
    });
  },{threshold:.5});
  document.querySelectorAll('#page-home .why-stat-num[data-target]').forEach(function(s){ obs.observe(s); });
}
function animateCounter(el){
  const target = parseFloat(el.dataset.target);
  const suffix = el.dataset.suffix || '';
  const isDecimal = target % 1 !== 0;
  const duration = 1600; const start = performance.now();
  (function step(now){
    const p = Math.min((now-start)/duration, 1);
    const ease = 1 - Math.pow(1-p, 3);
    const val = target * ease;
    el.textContent = (target >= 1000 ? Math.floor(val).toLocaleString() : isDecimal ? val.toFixed(1) : Math.floor(val)) + suffix;
    if(p < 1) requestAnimationFrame(step);
    else el.textContent = (target >= 1000 ? target.toLocaleString() : isDecimal ? target.toFixed(1) : target) + suffix;
  })(start);
}

/* ── SCORE BARS ──────────────────────────────────────────── */
let barsAnimated = false;
function triggerScoreBars(){
  if(barsAnimated) return; barsAnimated = true;
  document.querySelectorAll('#score-bars .anim-bar-fill').forEach(function(bar,i){
    setTimeout(function(){ bar.style.width = bar.dataset.width+'%'; }, i*180);
  });
}

/* ── TYPEWRITER ──────────────────────────────────────────── */
function initTypewriter(){
  const el = document.querySelector('#page-home .hero-sub');
  if(!el) return;
  const texts = ['Score Higher, Study Smarter','AI-Powered USMLE Prep','Trusted by 30,000+ Students','Pass Your Exam with Confidence'];
  let tIdx=0, cIdx=0, deleting=false;
  const cursor = document.createElement('span');
  cursor.className = 'typewriter-cursor';
  el.textContent = ''; el.appendChild(cursor);
  function type(){
    const current = texts[tIdx];
    if(!deleting){
      el.textContent = current.substring(0, cIdx+1); el.appendChild(cursor); cIdx++;
      if(cIdx === current.length){ deleting=true; setTimeout(type,1800); return; }
      setTimeout(type, 55);
    } else {
      el.textContent = current.substring(0, cIdx-1); el.appendChild(cursor); cIdx--;
      if(cIdx === 0){ deleting=false; tIdx=(tIdx+1)%texts.length; setTimeout(type,400); return; }
      setTimeout(type, 28);
    }
  }
  setTimeout(type, 1200);
}

/* ── BUTTON RIPPLE ───────────────────────────────────────── */
function initRipple(){
  document.querySelectorAll('#page-home .btn-primary,#page-home .btn-ghost,#page-home .btn-outline').forEach(function(btn){
    btn.style.position = 'relative'; btn.style.overflow = 'hidden';
    btn.addEventListener('click', function(e){
      const r = document.createElement('span');
      const rect = this.getBoundingClientRect();
      const size = Math.max(rect.width,rect.height)*2;
      r.style.cssText = 'position:absolute;width:'+size+'px;height:'+size+'px;left:'+(e.clientX-rect.left-size/2)+'px;top:'+(e.clientY-rect.top-size/2)+'px;background:rgba(255,255,255,.25);border-radius:50%;transform:scale(0);animation:ripple-expand .55s ease-out forwards;pointer-events:none;';
      this.appendChild(r); setTimeout(function(){r.remove();},600);
    });
  });
  if(!document.getElementById('ripple-style')){
    const s=document.createElement('style');
    s.id='ripple-style';
    s.textContent='@keyframes ripple-expand{to{transform:scale(1);opacity:0;}}';
    document.head.appendChild(s);
  }
}

/* ── CURSOR GLOW ─────────────────────────────────────────── */
function initCursorGlow(){
  const hero = document.querySelector('#page-home .hero');
  if(!hero) return;
  const glow = document.createElement('div');
  glow.style.cssText = 'position:absolute;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(96,165,250,.12),transparent 70%);pointer-events:none;transform:translate(-50%,-50%);transition:left .15s ease,top .15s ease;z-index:0;';
  hero.appendChild(glow);
  hero.addEventListener('mousemove',function(e){ const r=hero.getBoundingClientRect(); glow.style.left=(e.clientX-r.left)+'px'; glow.style.top=(e.clientY-r.top)+'px'; });
  hero.addEventListener('mouseleave',function(){ glow.style.opacity='0'; });
  hero.addEventListener('mouseenter',function(){ glow.style.opacity='1'; });
}

/* ── CARD TILT ───────────────────────────────────────────── */
function initCardTilt(){
  document.querySelectorAll('#page-home .wcard').forEach(function(card){
    card.addEventListener('mousemove',function(e){
      const r=card.getBoundingClientRect();
      const x=(e.clientX-r.left)/r.width-.5;
      const y=(e.clientY-r.top)/r.height-.5;
      card.style.transform='translateY(-5px) rotateY('+(x*10)+'deg) rotateX('+(-y*8)+'deg)';
      card.style.transition='transform .1s ease';
    });
    card.addEventListener('mouseleave',function(){ card.style.transform=''; card.style.transition='transform .4s ease,box-shadow .3s'; });
  });
}

/* ── MASTER HOME INIT ────────────────────────────────────── */
function initHomeAnimations(){
  barsAnimated = false;
  document.querySelectorAll('#page-home .reveal,#page-home .reveal-left,#page-home .reveal-right,#page-home .reveal-scale,#page-home .stagger-children').forEach(function(el){ el.classList.remove('revealed'); });
  document.querySelectorAll('#score-bars .anim-bar-fill').forEach(function(b){ b.style.width='0%'; });
  initParticles();
  initScrollReveal();
  initECG();
  initCounters();
  initTypewriter();
  initRipple();
  initCursorGlow();
  initCardTilt();
}

/* ── STEP-PICKER MODAL ───────────────────────────────────── */
window.openStepModal = function(){
  const m = document.getElementById('step-modal');
  if(!m) return;
  m.classList.add('open');
  document.body.style.overflow = 'hidden';
};
window.closeStepModal = function(){
  const m = document.getElementById('step-modal');
  if(!m) return;
  m.classList.remove('open');
  document.body.style.overflow = '';
};
window.handleStepModalBackdrop = function(e){
  if(e.target && e.target.id === 'step-modal') closeStepModal();
};

/* ── LOGIN MODAL ────────────────────────────────────────── */
window.openLoginModal = function(){
  const m = document.getElementById('login-modal');
  if(!m) return;
  m.classList.add('open');
  document.body.style.overflow = 'hidden';
};
window.closeLoginModal = function(){
  const m = document.getElementById('login-modal');
  if(!m) return;
  m.classList.remove('open');
  document.body.style.overflow = '';
};
window.handleLoginModalBackdrop = function(e){
  if(e.target && e.target.id === 'login-modal') closeLoginModal();
};

document.addEventListener('keydown', function(e){
  if(e.key === 'Escape'){ closeStepModal(); closeLoginModal(); }
});

/* ── BOOT ────────────────────────────────────────────────── */
initScrollProgress();
navigate('home');
</script>
</body>
</html>
