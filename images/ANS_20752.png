      <li><a id="nav-home"     onclick="navigate('home')">Home</a></li>
      <li><a id="nav-steps"    onclick="navigate('steps')">USMLE Guide</a></li>
      <li><a id="nav-pricing"  onclick="navigate('pricing')">Pricing</a></li>
